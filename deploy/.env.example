# ==============================================================================
# TenPoint — mẫu biến môi trường
# Tham chiếu: docs/03-sa/architecture.md mục 12
#
# CÁCH DÙNG:
#     cp deploy/.env.example deploy/.env
#     $EDITOR deploy/.env
#
# Docker Compose tự nạp file `deploy/.env` (cùng thư mục với docker-compose.yml).
#
# ⚠️  BẮT BUỘC ĐỔI TRƯỚC KHI LÊN PRODUCTION:
#       POSTGRES_PASSWORD   — mật khẩu DB
#       ADMIN_TOKEN         — bearer token cho POST /api/v1/admin/ingest
#       SITE_ADDRESS        — domain thật để Caddy xin chứng chỉ TLS
#       PUBLIC_BASE_URL     — URL công khai, dùng dựng short link tuyệt đối
#       ACME_EMAIL          — email nhận cảnh báo hết hạn chứng chỉ
#     Sinh giá trị ngẫu nhiên:   openssl rand -hex 32
#
# ⚠️  FILE `.env` THẬT ĐÃ NẰM TRONG .gitignore — KHÔNG BAO GIỜ COMMIT.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU (service `db`)
# ------------------------------------------------------------------------------

# Tên user Postgres. Cũng là superuser của instance (tạo extension unaccent/pg_trgm).
POSTGRES_USER=tenpoint

# 🔴 BẮT BUỘC ĐỔI Ở PRODUCTION. Giá trị dưới đây CHỈ dùng cho máy dev.
POSTGRES_PASSWORD=tenpoint_dev_only_change_me

# Tên database.
POSTGRES_DB=tenpoint

# DATABASE_URL KHÔNG cần khai ở đây — docker-compose.yml tự ghép từ 3 biến trên:
#   postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable


# ------------------------------------------------------------------------------
# 2. MÚI GIỜ  —  QUAN TRỌNG NHẤT VỚI CRON
# ------------------------------------------------------------------------------

# Cron chạy 06:00 / 14:00 / 22:00 GIỜ VIỆT NAM (ADR-004). Nếu TZ sai hoặc image
# thiếu gói tzdata, cron sẽ chạy theo UTC → LỆCH 7 TIẾNG, tin sáng ra lúc 13h.
# Cả `api` và `db` đều được set biến này.
TZ=Asia/Ho_Chi_Minh


# ------------------------------------------------------------------------------
# 3. LỊCH CHẠY PIPELINE (service `api`)
# ------------------------------------------------------------------------------

# Cron spec 5 trường, theo giờ VN. Mặc định: 8 tiếng một lần.
CRON_SPEC=0 6,14,22 * * *

# true  = bật scheduler trong process API (production).
# false = tắt, chỉ chạy ingest thủ công (`make ingest`). Dev/QA nên để false —
#         file docker-compose.dev.yml đã tự ép về false.
CRON_ENABLED=true


# ------------------------------------------------------------------------------
# 4. TÓM TẮT (summarizer)
# ------------------------------------------------------------------------------

# extractive = heuristic chọn câu giàu số liệu, KHÔNG cần API key (ADR-007).
#              → hệ thống chạy được end-to-end ngay sau `docker compose up`.
# anthropic  = gọi Claude API, chất lượng tóm tắt cao hơn, TỐN TIỀN.
SUMMARIZER_PROVIDER=extractive

# Chỉ cần khi SUMMARIZER_PROVIDER=anthropic. Để trống nếu dùng extractive.
# 🔴 Đây là secret — không commit.
ANTHROPIC_API_KEY=

# Model dùng khi provider=anthropic.
ANTHROPIC_MODEL=claude-sonnet-5


# ------------------------------------------------------------------------------
# 5. QUẢN TRỊ
# ------------------------------------------------------------------------------

# 🔴 BẮT BUỘC ĐỔI Ở PRODUCTION. Bearer token cho POST /api/v1/admin/ingest.
# Để TRỐNG ở production = endpoint admin bị vô hiệu (an toàn hơn token yếu).
# Sinh token:  openssl rand -hex 32
ADMIN_TOKEN=


# ------------------------------------------------------------------------------
# 6. URL CÔNG KHAI
# ------------------------------------------------------------------------------

# Dùng để dựng short link tuyệt đối (https://tenpoint.vn/r/a7Kx2p) và
# metadata SEO/sitemap của Next.js. KHÔNG có dấu `/` ở cuối.
#   local      : http://localhost
#   production : https://tenpoint.vn
PUBLIC_BASE_URL=http://localhost

# Timeout mỗi lời gọi API từ phía SSR của Next.js (ms).
# Hết timeout → FE render bằng dữ liệu mẫu thay vì trả lỗi 500.
API_TIMEOUT_MS=4000


# ------------------------------------------------------------------------------
# 7. INGEST — LỊCH SỰ VỚI NGUỒN TIN (NFR mục 11)
# ------------------------------------------------------------------------------

# Timeout tải mỗi bài (giây). Tăng lên nếu nguồn chậm, nhưng 1 run phải < 10 phút.
FETCH_TIMEOUT_SEC=20

# Trần số bài lấy từ MỘT nguồn trong một run — chặn 1 nguồn chiếm hết thời gian.
MAX_ARTICLES_PER_SOURCE=40

# User-Agent định danh rõ ràng để nguồn tin biết ai đang crawl và liên hệ được.
# ĐỔI domain trong URL cho khớp domain thật trước khi lên production.
USER_AGENT=TenPointBot/1.0 (+https://tenpoint.vn/bot)


# ------------------------------------------------------------------------------
# 8. QUAN SÁT / VẬN HÀNH
# ------------------------------------------------------------------------------

# /readyz trả 503 khi dữ liệu mới nhất cũ hơn ngưỡng này (giờ).
# 26 = 24h + 2h dung sai; cron chạy 3 lần/ngày nên dữ liệu không nên cũ quá 1 ngày.
READY_MAX_AGE_HOURS=26

# debug | info | warn | error
LOG_LEVEL=info

# json (production, dễ parse) | text (dev, dễ đọc)
LOG_FORMAT=json


# ------------------------------------------------------------------------------
# 9. CADDY — REVERSE PROXY & TLS
# ------------------------------------------------------------------------------

# Địa chỉ site mà Caddy phục vụ:
#   ":80"                          → HTTP thuần, không TLS (local/dev)
#   "tenpoint.vn"                  → TLS tự động qua Let's Encrypt (production)
#   "tenpoint.vn, www.tenpoint.vn" → nhiều domain
# 🔴 Phải trỏ DNS A/AAAA về IP server TRƯỚC khi đổi sang domain thật,
#    nếu không Caddy sẽ xin cert thất bại và dính rate limit của Let's Encrypt.
SITE_ADDRESS=:80

# 🔴 Email đăng ký ACME — nhận cảnh báo khi chứng chỉ sắp hết hạn.
ACME_EMAIL=devops@example.com

# Nguồn script hợp lệ trong CSP.
#   "'self' 'unsafe-inline'"  ← MẶC ĐỊNH. Next.js SSR cần inline script để hydrate.
#   "'self'"                  ← chỉ đặt SAU KHI FE thêm middleware sinh nonce cho CSP.
# ⚠️ BẮT BUỘC bọc trong dấu nháy KÉP: giá trị chứa dấu nháy đơn và dấu cách,
#    không bọc thì trình đọc .env của Docker Compose sẽ báo lỗi cú pháp.
CSP_SCRIPT_SRC="'self' 'unsafe-inline'"

# Cổng trên máy host mà Caddy chiếm. Đổi nếu 80/443 đã có dịch vụ khác.
HTTP_PORT=80
HTTPS_PORT=443


# ------------------------------------------------------------------------------
# 10. NGUỒN DỮ LIỆU — XEM "LƯU Ý PHÁP LÝ" TRONG README.md (PRD mục 4)
# ------------------------------------------------------------------------------

# Hồ sơ nguồn được bật, ánh xạ sang cột `sources.enabled` trong DB:
#   tier0 = CHỈ nguồn công bố chính thức (HOSE, HNX, UBCKNN, NHNN, TCTK)
#           → 🔴 GIÁ TRỊ BẮT BUỘC CHO PRODUCTION khi CHƯA có thoả thuận với báo.
#   all   = Tier 0 + Tier 1 + Tier 2 (toàn bộ báo chí) → CHỈ dùng cho dev/demo/QA.
# docker-compose.dev.yml tự set `all`; production giữ `tier0`.
SOURCES_PROFILE=tier0


# ------------------------------------------------------------------------------
# 11. CỔNG DEBUG Ở DEV (chỉ có tác dụng khi chạy `make dev`)
# ------------------------------------------------------------------------------

# Các cổng này chỉ bind vào 127.0.0.1, không phơi ra LAN.
DEV_DB_PORT=5432
DEV_API_PORT=8080
DEV_WEB_PORT=3000


# ------------------------------------------------------------------------------
# 12. GẮN NHÃN IMAGE
# ------------------------------------------------------------------------------

# Tag của image build ra: tenpoint/api:<APP_VERSION>, tenpoint/web:<APP_VERSION>
APP_VERSION=dev
IMAGE_PREFIX=tenpoint
