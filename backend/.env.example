# TenPoint API — biến môi trường (mục 12 docs/03-sa/architecture.md).
# Copy sang .env và điền giá trị thật. KHÔNG commit file .env có secret.

# --- Bắt buộc ---
DATABASE_URL=postgres://tenpoint:change-me@db:5432/tenpoint?sslmode=disable

# --- HTTP ---
PORT=8080
PUBLIC_BASE_URL=http://localhost

# --- Múi giờ & lịch chạy ---
TZ=Asia/Ho_Chi_Minh
CRON_SPEC=0 6,14,22 * * *
CRON_ENABLED=true

# --- Tóm tắt ---
# extractive = mặc định, KHÔNG cần API key (ADR-007).
SUMMARIZER_PROVIDER=extractive
# Chỉ cần khi SUMMARIZER_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Quản trị ---
# Để trống => POST /api/v1/admin/ingest bị khoá hoàn toàn (mặc định an toàn).
ADMIN_TOKEN=

# --- Bootstrap ---
# true = crawl ngay lúc khởi động nếu CSDL chưa có bài thật, để bảng digest có
# tin thật kèm link thật mà không phải chờ mốc cron kế tiếp. Tắt khi chạy test.
BOOTSTRAP_INGEST=true

# --- Crawler ---
FETCH_TIMEOUT_SEC=20
MAX_ARTICLES_PER_SOURCE=40
USER_AGENT=TenPointBot/1.0 (+https://tenpoint.vn/bot)

# --- Readiness ---
# Dữ liệu cũ hơn ngưỡng này (giờ) => /readyz trả 503.
READY_MAX_AGE_HOURS=26
